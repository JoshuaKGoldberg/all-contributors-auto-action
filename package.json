{
	"name": "all-contributors-auto-action",
	"version": "0.7.0",
	"description": "Fills in missing allcontributors entries for a repository. 👪",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/all-contributors-auto-action.git"
	},
	"license": "MIT",
	"author": {
		"name": "JoshuaKGoldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./lib/index.js"
	},
	"main": "lib/index.js",
	"files": [
		"lib/"
	],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"build:release": "rm -rf dist && ncc build src/index.ts -o dist",
		"format": "prettier .",
		"format:write": "pnpm format --write",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:knip:production": "knip --production",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"@types/node": "^26.0.0",
		"all-contributors-for-repository": "^1.0.0",
		"get-github-auth-token": "^0.2.0"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@vercel/ncc": "0.45.0",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"create-typescript-app": "2.87.18",
		"cspell": "10.5.2",
		"eslint": "10.15.0",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"knip": "6.48.0",
		"prettier": "3.10.0",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"pretty-quick": "4.2.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.74.0",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": ">=22.0.0"
	}
}
